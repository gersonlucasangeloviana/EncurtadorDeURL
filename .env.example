# Copie para .env e substitua os marcadores antes de executar.
# Estes defaults não constituem uma configuração de produção pronta.

# Origens públicas; sem credenciais, query, fragmento ou prefixo de path.
SHORT_BASE_URL=https://urlbase.example
FRONTEND_BASE_URL=https://painel.urlbase.example
ALLOWED_HOSTS=urlbase.example,painel.urlbase.example
# Endereço ou CIDR dedicado do Traefik na rede Docker. Use /32 para um IPv4 fixo.
TRUSTED_PROXY_CIDR=127.0.0.1/32

# Conexões privadas; não publicar portas do banco/cache na Internet.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://shortener:CHANGE_ME@postgres:5432/shortener
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_SECONDS=1800
REDIS_FILL_TTL_SECONDS=5
REDIS_MAXMEMORY=64mb
REDIS_SOCKET_TIMEOUT_SECONDS=0.02
CACHE_KEY_PREFIX=shortener

# URLs e nomes. O limite configurado de destino pode ser de 1 a 250 caracteres.
DESTINATION_MAX_LENGTH=250
ALLOWED_HTTPS_PORTS=443
BLOCKED_HOSTS=localhost,postgres,redis
BLOCKED_HOST_SUFFIXES=.localhost,.local,.internal
CUSTOM_NAME_MIN_LENGTH=3
CUSTOM_NAME_MAX_LENGTH=64
PUBLIC_PATH_MAX_LENGTH=64
RESERVED_ROUTE_NAMES=auth,assets,admin

# Feistel: validar parâmetros e versionar mudanças antes de emitir códigos.
# SHORT_CODE_KEY: preencher com 32 bytes aleatórios em hexadecimal (64 caracteres).
SHORT_CODE_KEY=
SHORT_CODE_BITS=40
FEISTEL_ROUNDS=8
ALPHABET=0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ
SHORT_CODE_LENGTH=7
SHORT_CODE_GENERATION_MAX_ATTEMPTS=10
SHORT_CODE_ALGORITHM_VERSION=1

# Chave privada entre frontend e API: 32 bytes aleatórios em hexadecimal minúsculo.
API_KEY=

# Senha para excluir links, pastas e paths (16 a 128 caracteres ASCII visíveis).
ADMIN_PASSWORD=

# Headers adicionais a ocultar, por nome ou expressão regular. A proteção
# interna de headers de credenciais sempre se aplica, inclusive com campos vazios.
ANALYTICS_REDACTED_HEADERS=
ANALYTICS_REDACTED_HEADER_PATTERN=
ANALYTICS_REDACTION_MARKER=[REDACTED]
ANALYTICS_MAX_EVENTS=100000
